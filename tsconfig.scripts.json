{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "lib": ["es2017"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": ["scripts/**/*", "types/**/*"],
  "exclude": ["node_modules"]
} 